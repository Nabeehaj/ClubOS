# Copy this file to .env and fill in what you need. .env is never committed.

# Get a free key at https://aistudio.google.com/apikey  (leave empty = AI buttons show "AI unavailable")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Change this to any long random string before deploying anywhere public
JWT_SECRET=dev-only-secret-change-me-before-deploying

# Where the React app runs (comma separated). Vite = 5173, create-react-app = 3000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Model "thinking" tokens per call. 0 = fast (a few seconds); higher = slower but more deliberate
GEMINI_THINKING_BUDGET=0
# Backup models tried in order when the main one is busy or retired
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
